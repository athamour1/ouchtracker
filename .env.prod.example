# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=ouchtracker
DB_PASSWORD=change_me_strong_password
DB_NAME=ouchtracker_db

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the API.
# Use /api when nginx proxies on the same domain (default, recommended).
# Use a full URL like https://api.your-domain.com/api for split deployments.
API_URL=/api

# ── Backend ───────────────────────────────────────────────────────────────────
# Must be the public URL the browser uses (for CORS). e.g. https://ouchtracker.example.com
CORS_ORIGIN=http://localhost

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_byte_hex_secret
JWT_EXPIRES_IN=8h

# ── Initial admin account (created once on first boot, skipped if already exists) ──
SEED_ADMIN_EMAIL=admin@ouchtracker.local
SEED_ADMIN_PASSWORD=change_me_strong_admin_password
SEED_ADMIN_NAME=System Admin

# ── Single sign-on (OIDC) — optional ──────────────────────────────────────────
# Lets users sign in through a self-hosted identity provider such as authentik
# (or Keycloak, Authelia, …). Off unless OIDC_ENABLED=true. See README → "Single sign-on".
OIDC_ENABLED=false
# authentik: https://<authentik-host>/application/o/<application-slug>/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Text on the login button ("Sign in with …")
OIDC_PROVIDER_NAME=authentik
# Public URL of this app (defaults to CORS_ORIGIN). Used to build the redirect URI.
# APP_URL=https://ouchtracker.example.com
# Redirect URI to register in the provider (default: ${APP_URL}/api/auth/oidc/callback)
# OIDC_REDIRECT_URI=
# OIDC_SCOPES=openid profile email
# Members of this provider group become ADMIN, everyone else CHECKER (synced on every login).
# Leave empty to manage roles in OuchTracker instead.
OIDC_ADMIN_GROUP=
# Create an account automatically the first time an unknown SSO user signs in.
# Set to false to only allow users an admin has already created (matched by email).
OIDC_AUTO_CREATE_USERS=true
# Set to false to hide the email/password form and allow SSO only.
LOCAL_LOGIN_ENABLED=true
